n1: int = 0
n2: int = 0
diferenca: int = 0

def calcular():
    global diferenca

    if n1 > n2:
        diferenca = n1 - n2
    else:
        diferenca = n2 - n1

def main():
    global n1, n2

    n1 = int(input('Digite o primeiro valor: '))
    n2 = int(input('Digite o segundo valor: '))

    calcular()

    print('A diferença é:', diferenca)

main()