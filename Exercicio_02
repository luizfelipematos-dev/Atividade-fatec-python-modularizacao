n1: float = 0
n2: float = 0
maior: float = 0

def calcular():
    global maior

    if n1 > n2:
        maior = n1
    else:
        maior = n2

def main():
    global n1, n2

    n1 = float(input('Digite o primeiro valor: '))
    n2 = float(input('Digite o segundo valor: '))

    calcular()

    print('O maior numero é:', maior)

main()