n1: int = 0
n2: int = 0

def calcular():
    if n1 > n2:
        print('Ordem crescente:', n2, 'e', n1)
    else:
        print('Ordem crescente:', n1, 'e', n2)

def main():
    global n1, n2

    n1 = int(input('Digite o primeiro valor: '))
    n2 = int(input('Digite o segundo valor: '))

    calcular()

main()